GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional paid fallback; requires the `anthropic` dependency extra
ANTHROPIC_API_KEY=
VISION_PROVIDER_ORDER=gemini,openrouter,groq,anthropic
OPENROUTER_VISION_MODEL=inclusionai/ling-3.2-flash:free
GROQ_VISION_MODEL=qwen/qwen3.8-27b
ANTHROPIC_VISION_MODEL=claude-haiku-5-5
CUTLINE_MOCK_MODE=false
CUTLINE_DATA_DIR=./data
# Optional backend physical-memory cap (default 3 GiB)
CUTLINE_MEMORY_MAX=3G
